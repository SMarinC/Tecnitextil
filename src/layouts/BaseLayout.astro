---
import '@fontsource/oswald/latin-600.css'
import '@fontsource/oswald/latin-700.css'
import '@fontsource/inter/latin-400.css'
import '@fontsource/inter/latin-500.css'
import '@fontsource/inter/latin-600.css'
import '../styles/global.css'
import interLatin400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url'
import oswaldLatin600 from '@fontsource/oswald/files/oswald-latin-600-normal.woff2?url'
import { COMPANY } from '../data/company'
import type { PageMeta } from '../data/pages'
import { OG_IMAGE_PATH, absoluteUrl } from '../data/seo'
import { serializeJsonLd } from '../lib/jsonLd'

// Self-hosted fonts (no request to Google, GDPR), Latin subset only. Body text and the
// header use Inter 400 and Oswald 600 on first paint, so both are preloaded.
interface Props {
  page: PageMeta
  jsonLd?: Record<string, unknown>
  // Share image; defaults to the site-wide og-image.png.
  image?: { url: string; width: number; height: number }
}

const {
  page,
  jsonLd,
  image = { url: absoluteUrl(OG_IMAGE_PATH), width: 1200, height: 630 },
} = Astro.props
const url = absoluteUrl(page.path)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="preload" href={interLatin400} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={oswaldLatin600} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={image.url} />
    <meta property="og:image:width" content={`${image.width}`} />
    <meta property="og:image:height" content={`${image.height}`} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={COMPANY.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image.url} />
    <link rel="canonical" href={url} />
    {page.noindex && <meta name="robots" content="noindex" />}
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)}></script>}
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido principal
    </a>
    <slot />
    <script>
      import { initAnalytics } from '../lib/analytics'

      initAnalytics()
    </script>
  </body>
</html>
