---
import '@fontsource/oswald/latin-600.css'
import '@fontsource/oswald/latin-700.css'
import '@fontsource/inter/latin-400.css'
import '@fontsource/inter/latin-500.css'
import '@fontsource/inter/latin-600.css'
import '../styles/global.css'
import interLatin400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url'
import oswaldLatin600 from '@fontsource/oswald/files/oswald-latin-600-normal.woff2?url'
import Analytics from '@vercel/analytics/astro'
import type { PageMeta } from '../data/pages'
import { OG_IMAGE_PATH, absoluteUrl } from '../data/seo'
import { serializeJsonLd } from '../lib/jsonLd'

// Self-hosted fonts (no request to Google, GDPR), Latin subset only. Body text and the
// header use Inter 400 and Oswald 600 on first paint, so both are preloaded.
interface Props {
  page: PageMeta
  jsonLd?: Record<string, unknown>
}

const { page, jsonLd } = Astro.props
const url = absoluteUrl(page.path)
const image = absoluteUrl(OG_IMAGE_PATH)
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="preload" href={interLatin400} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={oswaldLatin600} as="font" type="font/woff2" crossorigin="anonymous" />
    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    <link rel="canonical" href={url} />
    {page.noindex && <meta name="robots" content="noindex" />}
    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)}></script>}
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
