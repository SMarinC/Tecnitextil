---
import { Image } from 'astro:assets'
import { AWNING_MACHINES } from '../../data/awnings'
import { AWNING_PHOTOS } from './photos'
import styles from './AwningMachines.module.css'
---

<section class={styles.section}>
  <div class={styles.inner}>
    <div class={styles.layout}>
      <div class={styles.textCol}>
        <h2 class={styles.subheading}>{AWNING_MACHINES.services.heading}</h2>
        <ul class={styles.serviceList} role="list">
          {AWNING_MACHINES.services.items.map((service) => (
            <li class={styles.serviceItem}>{service}</li>
          ))}
        </ul>
      </div>
      <div class={styles.familiesCol}>
        <ul class={styles.familyList} role="list">
          {AWNING_MACHINES.families.map(({ title, description, photo }) => (
            <li class={styles.family}>
              <Image
                class={styles.familyImage}
                src={AWNING_PHOTOS[photo.key]}
                alt={photo.alt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 200px, (min-width: 768px) 160px, 100vw"
                loading="lazy"
                decoding="async"
              />
              <div class={styles.familyText}>
                <h3 class={styles.familyTitle}>{title}</h3>
                <p class={styles.familyDescription}>{description}</p>
              </div>
            </li>
          ))}
        </ul>
        <h2 class={styles.subheading}>{AWNING_MACHINES.components.heading}</h2>
        <ul class={styles.componentList} role="list">
          {AWNING_MACHINES.components.items.map((component) => (
            <li class={styles.componentItem}>{component}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
