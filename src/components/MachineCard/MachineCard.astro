---
import { Image } from 'astro:assets'
import { AVAILABILITY_LABELS, CATALOG_COPY } from '../../data/catalog'
import { machinePath, photoAlt, type Machine } from '../../lib/catalog'
import PhotoPlaceholder from '../PhotoPlaceholder/PhotoPlaceholder.astro'
import styles from './MachineCard.module.css'

// A machine in the listing: the whole card is one link to its page (stretched from the
// title), with no WhatsApp button of its own.
interface Props {
  machine: Machine
}

const { machine } = Astro.props
---

<li class={styles.card}>
  {machine.fotos[0] ? (
    <Image
      class={styles.photo}
      src={machine.fotos[0]}
      alt={photoAlt(machine, 0)}
      widths={[320, 640]}
      sizes="(min-width: 1280px) 280px, (min-width: 1024px) 30vw, (min-width: 640px) 45vw, 50vw"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <PhotoPlaceholder class={styles.photo} />
  )}
  <div class={styles.body}>
    <h3 class={styles.title}>
      <a href={machinePath(machine)} class={styles.link}>
        {machine.nombre}
      </a>
    </h3>
    <p class={styles.model}>
      {machine.marca} {machine.modelo}
    </p>
    <p class={styles.meta}>
      {AVAILABILITY_LABELS[machine.disponibilidad]} · {CATALOG_COPY.priceOnRequest}
    </p>
  </div>
</li>
