---
import { ICON_MARKUP, type IconName } from './icons'

interface Props {
  name: IconName
  class?: string
}

const { name, class: className } = Astro.props
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={ICON_MARKUP[name]}
/>
