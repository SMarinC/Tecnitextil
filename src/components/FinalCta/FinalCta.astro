---
import { FINAL_CTA } from '../../data/site'
import { CONTACT_SECTION_ID } from '../../data/navigation'
import { COMPANY } from '../../data/company'
import { buildMailtoUrl } from '../../data/contact'
import WhatsAppCta from '../WhatsAppCta/WhatsAppCta.astro'
import EmailCta from '../EmailCta/EmailCta.astro'
import styles from './FinalCta.module.css'
---

<section class={styles.section} id={CONTACT_SECTION_ID}>
  <h2 class={styles.heading}>{FINAL_CTA.heading}</h2>
  <p class={styles.subheading}>{FINAL_CTA.subheading}</p>
  <div class={styles.actions}>
    <WhatsAppCta variant="primary" label={FINAL_CTA.ctaLabel} />
    <EmailCta label={FINAL_CTA.emailLabel} />
  </div>
  <a class={styles.address} href={buildMailtoUrl()} data-contact="email">
    {COMPANY.email}
  </a>
</section>
