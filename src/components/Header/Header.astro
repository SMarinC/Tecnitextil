---
import { Image } from 'astro:assets'
import logo from '../../assets/logo.png'
import { COMPANY } from '../../data/company'
import { WHATSAPP_CTA } from '../../data/home'
import { MENU_TOGGLE_LABELS, NAV_ITEMS } from '../../data/sections'
import Icon from '../Icon/Icon.astro'
import WhatsAppCta from '../WhatsAppCta/WhatsAppCta.astro'
import styles from './Header.module.css'
---

<header class={styles.header} data-site-header>
  <div class={styles.inner}>
    <Image
      src={logo}
      alt={COMPANY.name}
      width={100}
      height={100}
      densities={[1, 2]}
      loading="eager"
      class={styles.logo}
    />
    <nav class={styles.nav} aria-label="Navegación principal">
      {NAV_ITEMS.map(({ label, href }) => (
        <a href={href} class={styles.navLink} data-nav-link>
          {label}
        </a>
      ))}
    </nav>
    <div class={styles.actions}>
      <WhatsAppCta variant="header" label={WHATSAPP_CTA.headerLabel} />
      <button
        type="button"
        class={styles.menuToggle}
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label={MENU_TOGGLE_LABELS.open}
        data-menu-toggle
        data-label-open={MENU_TOGGLE_LABELS.open}
        data-label-close={MENU_TOGGLE_LABELS.close}
      >
        <span class={styles.menuIconSlot} data-menu-icon="open">
          <Icon name="menu" class={styles.menuIcon} />
        </span>
        <span class={styles.menuIconSlot} data-menu-icon="close" hidden>
          <Icon name="close" class={styles.menuIcon} />
        </span>
      </button>
    </div>
  </div>
  <nav
    id="mobile-nav-panel"
    class={styles.mobileNav}
    aria-label="Navegación móvil"
    data-mobile-nav
    hidden
  >
    {NAV_ITEMS.map(({ label, href }) => (
      <a href={href} class={styles.mobileNavLink} data-nav-link>
        {label}
      </a>
    ))}
  </nav>
</header>

<script>
  import { initHeaderMenu } from '../../lib/headerMenu'

  const header = document.querySelector<HTMLElement>('[data-site-header]')
  if (header) initHeaderMenu(header)
</script>
