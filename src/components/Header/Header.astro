---
import { Image } from 'astro:assets'
import logo from '../../assets/logo.png'
import { COMPANY } from '../../data/company'
import { WHATSAPP_CTA } from '../../data/site'
import { MENU_TOGGLE_LABELS, NAV_ITEMS } from '../../data/navigation'
import Icon from '../Icon/Icon.astro'
import WhatsAppCta from '../WhatsAppCta/WhatsAppCta.astro'
import styles from './Header.module.css'

// The path of the page being rendered: its menu link, or its section's, is marked as current.
interface Props {
  currentPath: string
}

const { currentPath } = Astro.props

// A section's own page and the pages under it (/maquinas/<slug>) mark its link.
const isCurrent = (href: string) =>
  href.startsWith('/') && (currentPath === href || currentPath.startsWith(`${href}/`))
---

<header class={styles.header} data-site-header>
  <div class={styles.inner}>
    <a href="/" class={styles.logoLink}>
      {/* src/assets/logo.png and public/logo.png are intentional, byte-identical duplicates:
      astro:assets needs the source under src/, while the favicon and the JSON-LD `logo` need
      a stable /logo.png. Do not delete either one as a "duplicate". */}
      <Image
        src={logo}
        alt={COMPANY.name}
        width={100}
        height={100}
        densities={[1, 2]}
        loading="eager"
        class={styles.logo}
      />
    </a>
    <nav class={styles.nav} aria-label="Navegación principal">
      {NAV_ITEMS.map(({ label, href }) => (
        <a
          href={href}
          class={styles.navLink}
          data-nav-link
          aria-current={isCurrent(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <div class={styles.actions}>
      <WhatsAppCta variant="header" label={WHATSAPP_CTA.headerLabel} />
      <button
        type="button"
        class={styles.menuToggle}
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label={MENU_TOGGLE_LABELS.open}
        data-menu-toggle
        data-label-open={MENU_TOGGLE_LABELS.open}
        data-label-close={MENU_TOGGLE_LABELS.close}
      >
        <span class={styles.menuIconSlot} data-menu-icon="open">
          <Icon name="menu" class={styles.menuIcon} />
        </span>
        <span class={styles.menuIconSlot} data-menu-icon="close" hidden>
          <Icon name="close" class={styles.menuIcon} />
        </span>
      </button>
    </div>
  </div>
  <nav
    id="mobile-nav-panel"
    class={styles.mobileNav}
    aria-label="Navegación móvil"
    data-mobile-nav
    hidden
  >
    {NAV_ITEMS.map(({ label, href }) => (
      <a
        href={href}
        class={styles.mobileNavLink}
        data-nav-link
        aria-current={isCurrent(href) ? 'page' : undefined}
      >
        {label}
      </a>
    ))}
  </nav>
</header>

<script>
  import { initHeaderMenu } from '../../lib/headerMenu'

  const header = document.querySelector<HTMLElement>('[data-site-header]')
  if (header) initHeaderMenu(header)
</script>
