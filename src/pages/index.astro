---
import About from '../components/About/About.astro'
import Hero from '../components/Hero/Hero.astro'
import Reviews from '../components/Reviews/Reviews.astro'
import SectionCards from '../components/SectionCards/SectionCards.astro'
import ValueProps from '../components/ValueProps/ValueProps.astro'
import { HOME_PAGE } from '../data/pages'
import { localBusinessJsonLd, websiteJsonLd } from '../data/seo'
import SiteLayout from '../layouts/SiteLayout.astro'
---

<SiteLayout page={HOME_PAGE} jsonLd={[localBusinessJsonLd(), websiteJsonLd()]}>
  <Hero />
  <ValueProps />
  <SectionCards />
  <Reviews />
  <About />
</SiteLayout>
