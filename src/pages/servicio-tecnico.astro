import Services from '../components/Services/Services.astro'
import { TECHNICAL_SERVICE_HERO } from '../data/technicalService'
import { TECHNICAL_SERVICE_PAGE } from '../data/pages'
import SiteLayout from '../layouts/SiteLayout.astro'
---

<SiteLayout page={TECHNICAL_SERVICE_PAGE}>
