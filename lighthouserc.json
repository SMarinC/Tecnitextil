{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 2,
      "url": [
        "http://localhost/index.html",
        "http://localhost/servicio-tecnico.html",
        "http://localhost/toldos.html",
        "http://localhost/maquinas.html",
        "http://localhost/maquinas/ojales-botones-presillas.html",
        "http://localhost/maquinas/pespunte.html",
        "http://localhost/maquinas/pespunte-2-agujas.html",
        "http://localhost/maquinas/remalladora-overlock.html",
        "http://localhost/maquinas/ojales-botones-presillas/jk-t1900gsk-dii.html",
        "http://localhost/maquinas/remalladora-overlock/jk-c5t-a-4-m03.html",
        "http://localhost/condiciones-de-venta.html",
        "http://localhost/aviso-legal.html",
        "http://localhost/privacidad.html",
        "http://localhost/404.html"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.9 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/(condiciones-de-venta|aviso-legal|privacidad|404)\\.html$)",
          "assertions": {
            "categories:seo": ["error", { "minScore": 0.9 }]
          }
        },
        {
          "matchingUrlPattern": "/(condiciones-de-venta|aviso-legal|privacidad|404)\\.html$",
          "assertions": {
            "document-title": ["error", { "minScore": 1 }],
            "meta-description": ["error", { "minScore": 1 }],
            "http-status-code": ["error", { "minScore": 1 }],
            "link-text": ["error", { "minScore": 1 }],
            "crawlable-anchors": ["error", { "minScore": 1 }],
            "robots-txt": ["error", { "minScore": 1 }],
            "image-alt": ["error", { "minScore": 1 }],
            "hreflang": ["error", { "minScore": 1 }],
            "canonical": ["error", { "minScore": 1 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
